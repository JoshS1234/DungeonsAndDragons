{
  "name": "dungeonsanddragons",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc",
    "test:integration": "firebase emulators:exec --only firestore --project demo-dnd \"vitest run --config vitest.integration.config.ts\"",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "firebase-tools": "^15.33.0",
    "globals": "^17.13.0",
    "jsdom": "^27.0.1",
    "prettier": "^3.9.9",
    "sass": "^1.95.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.2.4",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "firebase": "^13.0.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-router-dom": "^7.10.1"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
